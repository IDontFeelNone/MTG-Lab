{
  "authorization_decisions": [
    "authorize_for_promotion",
    "reject",
    "return_for_additional_review"
  ],
  "canonical_state_must_match_request": true,
  "canonical_write": false,
  "exact_batch_count": 1,
  "immutable": true,
  "prohibited_operator_identities": [
    "AI",
    "Codex",
    "ChatGPT",
    "OpenAI",
    "placeholder"
  ],
  "promotion_performed": false,
  "required_fields": [
    "operator_identity",
    "operator_role",
    "review_reference",
    "reviewed_at",
    "authorization_decision",
    "operator_notes",
    "signature_request_digest",
    "authorized_batch_id",
    "authorized_candidate_digest"
  ],
  "review_reference_requirement": "durable non-placeholder reference containing a namespace and identifier",
  "schema_version": "phase-117-operator-authorization-v1",
  "timestamp_requirement": "RFC 3339 timestamp with timezone"
}
