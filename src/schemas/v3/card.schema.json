{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Card v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "game",
    "name",
    "normalized_name",
    "layout",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "const": "v3"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "normalized_name": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "string",
      "minLength": 1
    },
    "faces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mana_cost": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/knowledge"
              }
            ]
          },
          "mana_value": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "$ref": "#/$defs/knowledge"
              }
            ]
          },
          "colors": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "enum": [
                    "W",
                    "U",
                    "B",
                    "R",
                    "G"
                  ]
                },
                "uniqueItems": true
              },
              {
                "$ref": "#/$defs/knowledge"
              }
            ]
          },
          "type_line": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/knowledge"
              }
            ]
          },
          "oracle_text": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/knowledge"
              }
            ]
          },
          "power": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/knowledge"
              }
            ]
          },
          "toughness": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/knowledge"
              }
            ]
          },
          "loyalty": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/knowledge"
              }
            ]
          },
          "defense": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/knowledge"
              }
            ]
          }
        }
      }
    },
    "mana_cost": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "mana_value": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "colors": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "enum": [
              "W",
              "U",
              "B",
              "R",
              "G"
            ]
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "color_identity": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "enum": [
              "W",
              "U",
              "B",
              "R",
              "G"
            ]
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "type_line": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "supertypes": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "card_types": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "subtypes": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "oracle_text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "keywords": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "power": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "toughness": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "loyalty": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "defense": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "legalities": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "legality_references": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "related_cards": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "card_id",
              "relationship"
            ],
            "properties": {
              "card_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "relationship": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "path",
        "asserted_value",
        "source_id",
        "source_type",
        "evidence_class",
        "timestamp",
        "confidence",
        "verification_status",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "asserted_value": {},
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "official",
            "authoritative_structured",
            "verified_community",
            "direct_observation",
            "derived",
            "inferred",
            "unknown",
            "conflicting"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "publication_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verification_status": {
          "enum": [
            "unverified",
            "verified",
            "confirmed",
            "rejected"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "promoted",
            "rejected",
            "superseded",
            "conflicting"
          ]
        },
        "notes": {
          "type": "string"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "known_absent",
            "unknown",
            "provisional",
            "conflicting",
            "unresolved"
          ]
        },
        "value": {},
        "assertion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "known_absent",
                  "unresolved"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layout": {
            "enum": [
              "transform",
              "modal_dfc",
              "double_faced_token",
              "split",
              "adventure",
              "flip"
            ]
          }
        }
      },
      "then": {
        "required": [
          "faces"
        ],
        "properties": {
          "faces": {
            "minItems": 2
          }
        }
      }
    }
  ],
  "$id": "https://mtg-lab.dev/schemas/v3/card.schema.json"
}
