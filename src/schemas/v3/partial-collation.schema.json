{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Partial collation knowledge v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "subject_type",
    "facts",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "const": "v3"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "subject_type": {
      "enum": [
        "slot",
        "sheet",
        "sheet_membership",
        "product_composition"
      ]
    },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/knowledge"
      }
    },
    "simulation_required_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/"
      },
      "uniqueItems": true
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "path",
        "asserted_value",
        "source_id",
        "source_type",
        "evidence_class",
        "timestamp",
        "confidence",
        "verification_status",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "asserted_value": {},
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "official",
            "authoritative_structured",
            "verified_community",
            "direct_observation",
            "derived",
            "inferred",
            "unknown",
            "conflicting"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "publication_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verification_status": {
          "enum": [
            "unverified",
            "verified",
            "confirmed",
            "rejected"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "promoted",
            "rejected",
            "superseded",
            "conflicting"
          ]
        },
        "notes": {
          "type": "string"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "known_absent",
            "unknown",
            "provisional",
            "conflicting",
            "unresolved"
          ]
        },
        "value": {},
        "assertion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "known_absent",
                  "unresolved"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    }
  },
  "$id": "https://mtg-lab.dev/schemas/v3/partial-collation.schema.json"
}
