{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Assertion v3",
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "path",
        "asserted_value",
        "source_id",
        "source_type",
        "evidence_class",
        "timestamp",
        "confidence",
        "verification_status",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "asserted_value": {},
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "official",
            "authoritative_structured",
            "verified_community",
            "direct_observation",
            "derived",
            "inferred",
            "unknown",
            "conflicting"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "publication_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verification_status": {
          "enum": [
            "unverified",
            "verified",
            "confirmed",
            "rejected"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "promoted",
            "rejected",
            "superseded",
            "conflicting"
          ]
        },
        "notes": {
          "type": "string"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$ref": "#/$defs/assertion",
  "$id": "https://mtg-lab.dev/schemas/v3/assertion.schema.json"
}
