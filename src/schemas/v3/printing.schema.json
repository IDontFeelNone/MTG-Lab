{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Printing v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "card_id",
    "set_id",
    "collector_number",
    "language",
    "assertions"
  ],
  "properties": {
    "schema_version": {
      "const": "v3"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "card_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "set_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "collector_number": {
      "type": "string",
      "minLength": 1
    },
    "collector_number_namespace": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "rarity": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "product_classification": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "artist": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "flavor_text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "printed_name": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "printed_text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "printed_type_line": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "frame": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "border": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "finishes": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "treatments": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "promotional_flags": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "release_date": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "external_identifiers": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "image_references": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "license"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "face": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        {
          "$ref": "#/$defs/knowledge"
        }
      ]
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "path",
        "asserted_value",
        "source_id",
        "source_type",
        "evidence_class",
        "timestamp",
        "confidence",
        "verification_status",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "asserted_value": {},
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "official",
            "authoritative_structured",
            "verified_community",
            "direct_observation",
            "derived",
            "inferred",
            "unknown",
            "conflicting"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "publication_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verification_status": {
          "enum": [
            "unverified",
            "verified",
            "confirmed",
            "rejected"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "promoted",
            "rejected",
            "superseded",
            "conflicting"
          ]
        },
        "notes": {
          "type": "string"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "known_absent",
            "unknown",
            "provisional",
            "conflicting",
            "unresolved"
          ]
        },
        "value": {},
        "assertion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unknown",
                  "known_absent",
                  "unresolved"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    }
  },
  "$id": "https://mtg-lab.dev/schemas/v3/printing.schema.json"
}
