{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-lab.dev/schemas/v1/acquisition-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "product_id",
    "source_ids",
    "raw_destination",
    "acquisition_method",
    "acquisition_status",
    "processing_status"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "raw_destination": {
      "type": "string",
      "minLength": 1
    },
    "acquisition_method": {
      "type": "string",
      "minLength": 1
    },
    "acquisition_status": {
      "enum": [
        "planned",
        "acquired",
        "failed",
        "deprecated"
      ]
    },
    "last_attempted_date": {
      "type": "string",
      "format": "date"
    },
    "last_successful_acquisition_date": {
      "type": "string",
      "format": "date"
    },
    "expected_content_type": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "additionalProperties": true
    },
    "processing_status": {
      "enum": [
        "unprocessed",
        "processed",
        "rejected"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
