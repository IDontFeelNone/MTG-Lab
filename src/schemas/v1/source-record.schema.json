{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-lab.dev/schemas/v1/source-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "source_classification",
    "provider",
    "source_location",
    "access_date",
    "verification_status",
    "claims",
    "record_version"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_classification": {
      "enum": [
        "official",
        "community",
        "inferred",
        "internal"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "source_location": {
      "type": "string",
      "minLength": 1
    },
    "access_date": {
      "type": "string",
      "format": "date"
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "verification_status": {
      "enum": [
        "confirmed",
        "supported",
        "unverified"
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "archival_location": {
      "type": "string",
      "minLength": 1
    },
    "record_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
