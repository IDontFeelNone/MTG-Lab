{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://mtg-lab.dev/schemas/v1/raw-snapshot.schema.json","title":"Raw Snapshot v1","type":"object","additionalProperties":false,"required":["schema_version","snapshot_id","provider_id","dataset","acquired_at","publication_timestamp","request_parameters","content_type","content_encoding","raw_payload_location","payload_byte_length","checksum","acquisition_status","license_reference","parent_snapshot_id"],"properties":{"schema_version":{"const":"raw-snapshot-v1"},"snapshot_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"provider_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"dataset":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"acquired_at":{"type":"string","format":"date-time"},"publication_timestamp":{"type":["string","null"],"format":"date-time"},"request_parameters":{"type":"object"},"content_type":{"type":"string"},"content_encoding":{"type":"string"},"raw_payload_location":{"const":"payload.bin"},"payload_byte_length":{"type":"integer","minimum":0},"checksum":{"type":"object","additionalProperties":false,"required":["algorithm","value"],"properties":{"algorithm":{"const":"sha256"},"value":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"acquisition_status":{"type":"string"},"license_reference":{"type":["string","null"]},"parent_snapshot_id":{"type":["string","null"]}}}
