{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-lab.dev/schemas/v1/product.schema.json",
  "title": "MTG Lab Product",
  "description": "A sealed or digital product definition that references slots by stable identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "game",
    "name",
    "product_type",
    "slot_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "game": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "product_type": {
      "type": "string",
      "minLength": 1
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "slot_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
