{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable supplied-deck research investigation V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "key", "question", "created_at", "investigation_id", "engine", "revisions", "artifact_id"],
  "properties": {
    "schema_version": {"const": "portable-deck-investigation-v1"},
    "key": {"$ref": "#/$defs/key"},
    "question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "created_at": {"$ref": "#/$defs/time"},
    "investigation_id": {"$ref": "#/$defs/hash"},
    "artifact_id": {"$ref": "#/$defs/hash"},
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "input_schema", "report_schema", "implementation"],
      "properties": {
        "operation": {"const": "workbench.adapter.assess_workbench"},
        "input_schema": {"const": "deck-workbench-input-v1"},
        "report_schema": {"const": "deck-workbench-report-v1"},
        "implementation": {
          "type": "object", "additionalProperties": false,
          "required": ["probability/supplied_deck.py", "probability/draw_access.py", "workbench/adapter.py"],
          "properties": {
            "probability/supplied_deck.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "probability/draw_access.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "workbench/adapter.py": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "revisions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/revision"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "notes": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["created_at", "hypothesis", "outcome", "assumptions", "notes", "counterexamples", "rejected_alternatives", "unresolved_questions", "evidence_references"],
      "properties": {
        "created_at": {"$ref": "#/$defs/time"},
        "hypothesis": {"type": "string", "maxLength": 4000},
        "outcome": {"enum": ["exploring", "rejected", "unresolved", "supported_under_declared_assumptions"]},
        "assumptions": {"$ref": "#/$defs/notes"}, "notes": {"$ref": "#/$defs/notes"},
        "counterexamples": {"$ref": "#/$defs/notes"}, "rejected_alternatives": {"$ref": "#/$defs/notes"},
        "unresolved_questions": {"$ref": "#/$defs/notes"},
        "evidence_references": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["relation", "label", "reference"],
            "properties": {
              "relation": {"enum": ["supporting", "contradicting", "qualifying"]},
              "label": {"type": "string", "minLength": 1, "maxLength": 128},
              "reference": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64}|user:[A-Za-z0-9][A-Za-z0-9._:-]{0,63})$"}
            }
          }
        }
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "revision_id", "parent_id", "branch_id", "metadata", "analytical_input", "result"],
      "properties": {
        "schema_version": {"const": "deck-research-revision-v1"},
        "revision_id": {"$ref": "#/$defs/hash"},
        "parent_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "branch_id": {"$ref": "#/$defs/key"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "analytical_input": {"type": ["object", "null"]},
        "result": {"type": ["object", "null"]}
      }
    }
  },
  "$comment": "The owning validator additionally enforces byte/branch budgets, lineage, identities, engine compatibility and exact input/report correspondence by recomputation. Embedded inputs/reports are validated by the existing workbench owner, never trusted as arbitrary JSON."
}
