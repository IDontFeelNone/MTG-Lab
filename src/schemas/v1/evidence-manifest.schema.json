{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-lab.dev/schemas/v1/evidence-manifest.schema.json",
  "title": "MTG Lab Archived Evidence Manifest",
  "description": "A content-identified bundle of repository-archived evidence files and their provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "game",
    "product_id",
    "title",
    "bundle_version",
    "created_at",
    "source_ids",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "game": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "product_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "bundle_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "media_type",
          "byte_size",
          "sha256",
          "provenance"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "path": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))files/[^/]+(?:/[^/]+)*$"
          },
          "media_type": {"type": "string", "minLength": 1},
          "byte_size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "claims"],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "claims": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "notes": {"type": "string", "minLength": 1}
              }
            }
          },
          "population_batch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected_record_count", "expected_printing_ids"],
            "properties": {
              "expected_record_count": {"type": "integer", "minimum": 1, "maximum": 25},
              "expected_printing_ids": {
                "type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
              }
            }
          }
        }
      }
    },
    "notes": {"type": "string"}
  }
}
