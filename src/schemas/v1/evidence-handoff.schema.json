{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-lab.dev/schemas/v1/evidence-handoff.schema.json",
  "title": "Product-agnostic External Evidence Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "created_at", "sources", "required_artifact_ids", "artifacts", "claims"],
  "properties": {
    "schema_version": {"const": "v1"},
    "id": {"$ref": "#/$defs/identifier"},
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "reference"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "reference": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "required_artifact_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "media_type", "byte_size", "sha256", "source_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))artifacts/[^/]+(?:/[^/]+)*$"},
          "media_type": {"type": "string", "minLength": 1},
          "byte_size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "topic", "value", "statement", "artifact_ids", "source_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "topic": {"type": "string", "minLength": 1},
          "value": {"type": ["string", "number", "integer", "boolean", "null"]},
          "statement": {"type": "string", "minLength": 1},
          "artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        }
      }
    }
  },
  "$defs": {"identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}}
}
