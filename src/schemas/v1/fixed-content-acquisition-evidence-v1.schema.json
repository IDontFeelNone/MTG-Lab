    "transaction_costs":{"type":"object","additionalProperties":false,"required":["currency","shipping","marketplace_fees","other_costs","total","completeness","evidence_source_ids","seller_order_assumptions"],"properties":{"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"shipping":{"type":["string","null"],"pattern":"^(?:[0-9]+(?:\\.[0-9]+)?|-0(?:\\.0+)?)$"},"marketplace_fees":{"type":["string","null"],"pattern":"^(?:[0-9]+(?:\\.[0-9]+)?|-0(?:\\.0+)?)$"},"other_costs":{"type":["string","null"],"pattern":"^(?:[0-9]+(?:\\.[0-9]+)?|-0(?:\\.0+)?)$"},"total":{"type":["string","null"],"pattern":"^(?:[0-9]+(?:\\.[0-9]+)?|-0(?:\\.0+)?)$"},"completeness":{"enum":["complete","incomplete","unknown"]},"evidence_source_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"seller_order_assumptions":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
