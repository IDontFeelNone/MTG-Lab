    "manifest":{"type":"object","additionalProperties":false,"required":["schema_version","manifest_id","product_id","game_id","product_type","release_date","effective_at","completeness","components","evidence","unknowns","assumptions","limitations"],"properties":{"schema_version":{"const":"fixed-content-product-manifest-v1"},"manifest_id":{"type":"string","pattern":"^manifest-sha256:[0-9a-f]{64}$"},"product_id":{"type":"string","minLength":1},"game_id":{"type":"string","minLength":1},"product_type":{"type":"string","minLength":1},"release_date":{"type":["string","null"],"format":"date"},"effective_at":{"type":["string","null"],"format":"date-time"},"completeness":{"enum":["complete","incomplete","unknown"]},"components":{"type":"array","minItems":1,"items":{"type":"object","required":["component_id","component_type","quantity","printing_id","finish","language","treatment","evidence_ids","unknowns"],"additionalProperties":false,"properties":{"component_id":{"type":"string","minLength":1},"component_type":{"type":"string","minLength":1},"quantity":{"type":"integer","minimum":1},"printing_id":{"type":["string","null"]},"finish":{"type":["string","null"]},"language":{"type":["string","null"]},"treatment":{"type":["string","null"]},"evidence_ids":{"type":"array","items":{"type":"string"}},"unknowns":{"type":"array","items":{"type":"string"}}}}},"evidence":{"type":"array","items":{"type":"object","required":["evidence_id","source_identity","content_digest"],"properties":{"evidence_id":{"type":"string","minLength":1},"source_identity":{"type":"string","minLength":1},"content_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"recorded_at":{"type":"string","format":"date-time"},"locator":{"type":"string","minLength":1}},"additionalProperties":false}},"unknowns":{"type":"array","items":{"type":"string"}},"assumptions":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}}}},
    "offer":{"type":"object","additionalProperties":false,"required":["schema_version","offer_id","product_id","provider","observed_at","effective_at","currency","listed_price","shipping","tax","transaction_fees","discounts","effective_cost","evidence","assumptions","limitations"],"properties":{"schema_version":{"const":"product-acquisition-offer-v1"},"offer_id":{"type":"string","minLength":1},"product_id":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"},"effective_at":{"type":["string","null"],"format":"date-time"},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"listed_price":{"type":"string"},"shipping":{"type":"string"},"tax":{"type":"string"},"transaction_fees":{"type":"string"},"discounts":{"type":"string"},"effective_cost":{"type":"string"},"evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["evidence_id","source_identity","content_digest"],"properties":{"evidence_id":{"type":"string","minLength":1},"source_identity":{"type":"string","minLength":1},"content_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"recorded_at":{"type":"string","format":"date-time"},"locator":{"type":"string","minLength":1}},"additionalProperties":false}},"assumptions":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}}}},
    "valuation":{"type":"object","additionalProperties":false,"required":["schema_version","component_id","printing_id","finish","language","treatment","market_observation"],"properties":{"schema_version":{"const":"component-valuation-input-v1"},"component_id":{"type":"string","minLength":1},"printing_id":{"type":["string","null"]},"finish":{"type":["string","null"]},"language":{"type":["string","null"]},"treatment":{"type":["string","null"]},"market_observation":{"$ref":"#/$defs/market_observation"}}},
    "market_observation":{"type":"object","additionalProperties":false,"required":["schema_version","observation_id","entity_type","entity_id","provider","observed_at","recorded_at","currency","price_type","finish","provenance","price","buylist_price","spread","provider_confidence","listing_count","sales_count"],"properties":{"schema_version":{"const":"market-observation-v1"},"observation_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"entity_type":{"enum":["card","printing"]},"entity_id":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"},"recorded_at":{"type":"string","format":"date-time"},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"price_type":{"type":"string","minLength":1},"finish":{"type":["string","null"]},"provenance":{"type":"object","minProperties":1},"price":{"type":["string","null"],"pattern":"^(?:[0-9]+(?:\\.[0-9]+)?|-0(?:\\.0+)?)$"},"buylist_price":{"type":["string","null"],"pattern":"^(?:[0-9]+(?:\\.[0-9]+)?|-0(?:\\.0+)?)$"},"spread":{"type":["string","null"],"pattern":"^(?:[0-9]+(?:\\.[0-9]+)?|-0(?:\\.0+)?)$"},"provider_confidence":{"type":["string","null"],"pattern":"^(?:[0-9]+(?:\\.[0-9]+)?|-0(?:\\.0+)?)$"},"listing_count":{"type":["integer","null"],"minimum":0},"sales_count":{"type":["integer","null"],"minimum":0}}}
