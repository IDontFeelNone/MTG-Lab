{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-lab.dev/schemas/v1/printing.schema.json",
  "title": "MTG Lab Printing",
  "description": "A specific physical or digital printing of a canonical card.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "card_id",
    "set_code",
    "collector_number",
    "rarity"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "card_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "set_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "collector_number": {
      "type": "string",
      "minLength": 1
    },
    "rarity": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "treatments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
