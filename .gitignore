# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python environments
.venv/
venv/
ENV/
env/
.python-version

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
wheels/

# Test, type-checking, and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# Local configuration and secrets
.env
.env.*
!.env.example

# Data generated locally; retain directory placeholders
data/raw/*
!data/raw/.gitkeep
!data/raw/magic/
!data/raw/magic/mystery_booster_2/
!data/raw/magic/mystery_booster_2/wave_1/
!data/raw/magic/mystery_booster_2/wave_1/card-printing-evidence.json
data/processed/*
!data/processed/.gitkeep
data/intermediate/*
!data/intermediate/parsed/
!data/intermediate/parsed/**
!data/intermediate/candidates/
!data/intermediate/candidates/**
!data/intermediate/reviews/
!data/intermediate/reviews/**
!data/intermediate/research/
!data/intermediate/research/**
data/canonical/*
!data/canonical/.gitkeep
!data/canonical/games/
!data/canonical/games/**
data/validation/*
!data/validation/.gitkeep
!data/validation/mystery_booster_2/
!data/validation/mystery_booster_2/phase_81_coverage.json

