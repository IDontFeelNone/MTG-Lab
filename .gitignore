# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python environments
.venv/
venv/
ENV/
env/
.python-version

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
wheels/

# Test, type-checking, and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.pyre/
.ruff_cache/
.pytype/

# Jupyter
.ipynb_checkpoints/

# Local configuration and secrets
.env
.env.*
!.env.example

# Data generated locally; retain directory placeholders
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/canonical/*
!data/canonical/.gitkeep
data/validation/*
!data/validation/.gitkeep

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
