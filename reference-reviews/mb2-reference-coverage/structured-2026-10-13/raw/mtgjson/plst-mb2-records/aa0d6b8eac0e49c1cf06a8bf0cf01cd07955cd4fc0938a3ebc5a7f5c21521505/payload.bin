:"MOM-206","originalReleaseDate":"2024-08-02","printings":["MOM","PLST"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/dac89cd6a53450ae","tcgplayer":"https://mtgjson.com/links/fbe698214bd7266d"},"rarity":"uncommon","rulings":[{"date":"2023-04-14","text":"If all of Storm the Seedcore’s targets are illegal at the time the spell tries to resolve, it won’t resolve and none of its effects will happen. Creatures you control won’t gain vigilance and trample."},{"date":"2023-04-14","text":"If some of the creatures are illegal targets as Storm the Seedcore tries to resolve, the original distribution of counters still applies and the counters that would have been put on the illegal targets are lost. They won’t be put instead on a legal target."},{"date":"2023-04-14","text":"You choose how many targets Storm the Seedcore has and how the counters will be distributed as you cast the spell. Each target must receive at least one counter."}],"setCode":"PLST","skuIds":{"nonfoil":"87b3a12f-6d10-5aab-90c1-2d5eb7498788"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"Distribute four +1/+1 counters among up to four target creatures you control. Creatures you control gain vigilance and trample until end of turn.","type":"Sorcery","types":["Sorcery"],"uuid":"cfc8fad3-ccb4-544b-a5c3-6381111402dd"},{"artist":"Trevor Hairsine","artistIds":["7c1d7b59-dbf1-4ca8-9975-8e01c593da6e"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["R"],"colors":["R"],"convertedManaCost":1.0,"edhrecRank":24346,"edhrecSaltiness":0.24,"finishes":["nonfoil"],"flavorText":"For some reason, goblin fi