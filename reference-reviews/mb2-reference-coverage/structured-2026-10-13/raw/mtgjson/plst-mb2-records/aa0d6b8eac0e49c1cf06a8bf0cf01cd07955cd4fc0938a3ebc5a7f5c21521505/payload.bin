.0,"finishes":["nonfoil"],"foreignData":[],"frameVersion":"1997","identifiers":{"cardKingdomId":"304105","cardsphereId":"128652","deckboxId":"95963","mcmId":"791933","mtgjsonV4Id":"69061f2d-f6f1-58c6-807c-01c666ac623a","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"775acde2-b3ed-4ad1-aeaa-da1f417e4eca","scryfallIllustrationId":"dfe69bab-7af3-4e17-8d51-32f9cf167344","scryfallOracleId":"1d5f0a1c-88e0-4603-97af-8ed47766812e","tcgplayerProductId":"583208"},"isReprint":true,"keywords":["Buyback"],"language":"English","layout":"normal","legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","oathbreaker":"Legal","penny":"Legal","predh":"Legal","premodern":"Legal","vintage":"Legal"},"manaCost":"{X}{R}{R}","manaValue":2.0,"name":"Fanning the Flames","number":"STH-80","originalReleaseDate":"2024-08-02","printings":["PLST","STH","TPR"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/629737574cdc83b0","cardmarket":"https://mtgjson.com/links/6720c39087fab672","tcgplayer":"https://mtgjson.com/links/ec44608c666b7562"},"rarity":"uncommon","setCode":"PLST","skuIds":{"nonfoil":"17813a58-906f-5733-92ce-543a3f075ad0"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"Buyback {3} (You may pay an additional {3} as you cast this spell. If you do, put this card into your hand as it resolves.)\nFanning the Flames deals X damage to any target.","type":"Sorcery","types":["Sorcery"],"uuid":"888c7d6b-e271-5ac3-aae0-680dc207d13f"},{"artist":"Rebecca Guay","artistIds":["f8f662fa-d597-46a3-afb2-91d6e13243e2"],"availability":["paper"],"borderColor":"black","colorIdentity":["G"],"colors":["G"],"convertedManaCost":2.0,"edhrecRank":5734,"edhrecSaltiness":0.25,"finishes":["nonfoil"],"foreignData":[],"frameEffects":["tombstone"],"frameVersion":"1997","identifiers":{"cardKingdomId":"304361","cardsphereId":"127519","deckboxId":"95964","mcmId":"792509","mtgjsonV4Id":"5129b55d-4757-5698-bd8b-eb4071b7ff04","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"05087bc1-ac45-4405-9074-8272a321ab86","scryfallIllustrationId":"3a575d07-fc52-4845-900e-1db1bc44ad15","scryfallOracleId":"b6d22228-a45e-4296-9ae2-1649e04b1c53","tcgplayerProductId":"564110"},"isReprint":true,"keywords":["Flashback"],"language":"English","layout":"normal","legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","oathbreaker":"Legal","pauper":"Legal","paupercommander":"Legal","predh":"Legal","premodern":"Legal","vintage":"Legal"},"manaCost":"{1}{G}","manaValue":2.0,"name":"Moment's Peace","number":"TD0-A80","originalReleaseDate":"2024-08-02","printings":["ODY","PLST","SLD","TD0","WC03"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/495e8c807d2ea73c","cardmarket":"https://mtgjson.com/links/910e235c34faf94f","tcgplayer":"https://mtgjson.com/links/f78df1ee150d8451"},"rarity":"common","rulings":[{"date":"2021-03-19","text":"\"Flashback [cost]\" means \"You may cast this card from your graveyard by paying [cost] rather than paying its mana cost\" and \"If the flashback cost was paid, exile this card instead of putting it anywhere else any time it would leave the stack.\""},{"date":"2021-03-19","text":"A spell cast using flashback will always be exiled afterward, whether it resolves, is countered, or leaves the stack in some other way."},{"date":"2021-03-19","text":"If a card with flashback is put into your graveyard during your turn, you can cast it if it's legal to do so before any other player can take any actions."},{"date":"2021-03-19","text":"To determine the total cost of a spell, start with the mana cost or alternative cost (such as a flashback cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was."},{"date":"2021-03-19","text":"You can cast a spell using flashback even if it was somehow put into your graveyard without having been cast."},{"date":"2021-03-19","text":"You must still follow any timing restrictions and permissions, including those based on the card's type. For instance, you can cast a sorcery using flashback only when you could normally cast a sorcery."}],"setCode":"PLST","skuIds":{"nonfoil":"74ae0bbd-9ece-5677-90f3-4e12864bba1e"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"Prevent all combat damage that would be dealt this turn.\nFlashback {2}{G} (You may cast this card from your graveyard for its flashback cost. Then exile it.)","type":"Instant","types":["Instant"],"uuid":"7c714d73-1d87-5833-ab0f-903993eb5dc0"},{"artist":"Marta Nael","artistIds":["266ab861-ed64-4ba5-865c-f18758421cc3"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["U"],"colors":["U"],"convertedManaCost":1.0,"edhrecRank":636,"edhrecSaltiness":0.16,"finishes":["nonfoil"],"foreignData":[],"frameVersion":"2015","identifiers":{"cardKingdomId":"262494","cardsphereId":"89925","deckboxId":"66204","mcmId":"662627","mtgjsonV4Id":"eb131108-a4bb-5c65-9219-ab835be996a4","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"715cf105-edf8-4d75-9279-c83431c087c6","scryfallIllustrationId":"68fb67ce-bf22-4042-bf87-a992b8c38ecc","scryfallOracleId":"36f68aa3-9955-46f1-bc87-497f16ef5222","tcgplayerProductId":"275215"},"isReprint":true,"language":"English","layout":"class","legalities":{"brawl":"Legal","commander":"Legal","competitivebrawl":"Legal","duel":"Legal","gladiator":"Legal","historic":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","pioneer":"Legal","timeless":"Legal","vintage":"Legal"},"manaCost":"{U}","manaValue":1.0,"name":"Wizard Class","number":"AFR-81","originalReleaseDate":"2022-06-10","printings":["AFR","BLC","PLST"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/31e6a4e0d6ee092c","cardmarket":"https://mtgjson.com/links/36f758835b70bd16","tcgplayer":"https://mtgjson.com/links/a40f9194b4dfef06"},"rarity":"uncommon","rulings":[{"date":"2021-07-23","text":"Each Class has five abilities. The three in the major sections of its text box are class abilities. Class abilities can be static, activated, or triggered abilities. The other two are level abilities, one activated ability to advance the Class to level 2 and another to advance the Class to level 3."},{"date":"2021-07-23","text":"Each Class starts with only the first of three class abilities. As the first level ability resolves, the Class becomes level 2 and gains the second class ability. As the second level ability resolves, the Class becomes level 3 and gains the third class ability."},{"date":"2021-07-23","text":"Gaining a level is a normal activated ability. It uses the stack and can be responded to."},{"date":"2021-07-23","text":"Gaining a level won't remove abilities that a Class had at a previous level."},{"date":"2021-07-23","text":"Some Class cards have an effect that increases when more are under your control. For example, if you have multiple Barbarian Class cards, you roll that many additional dice and ignore that many of the lowest rolls."},{"date":"2021-07-23","text":"You can multiclass or even control multiple Class enchantments of the same class. Each Class permanent tracks its own level separately."},{"date":"2021-07-23","text":"You can't activate the first level ability of a Class unless that Class is level 1. Similarly, you can't activate the second level ability of a Class unless that Class is level 2."}],"setCode":"PLST","skuIds":{"nonfoil":"3b839063-9bcf-5231-bac1-32d975a00fcf"},"sourceProducts":{"nonfoil":["01ef781b-7efa-5ce1-b2e8-0567d7a9a7f2","06b640f6-7bcc-52ee-bd98-bce4c89ef4a4","079afeee-9345-5b19-b902-d8d1725bfa45","0db8ec71-b700-5355-913d-285f11687911","104d4709-8535-5fdd-8dda-51b069cc4c0a","16e5db66-aae0-53e0-9dc1-08965be6c365","1db93605-0a4e-5e5b-80a2-18a6e177f51d","21687813-7026-57b9-a323-b276252555cf","2893f4f4-daec-5b4d-b5ce-a4e9444cae84","339add5b-2f64-595a-8a2f-b492e759318a","3ccdf5f7-6548-57af-9e1c-a639100d1925","3f6005aa-7643-5790-83e1-f50c49c7b725","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","5280c1f5-8d88-56fa-9531-bc27517fa5ec","6d0880d3-b3a8-5df5-a526-5be1def7899b","84faf770-a5ed-51c1-922c-71ae2146ebed","89ec73e1-5d97-57fc-b6a5-1eb6ecba6695","90ce6f46-5779-57ee-9dc4-e293d6bc905f","96e44935-25de-5b9c-b1cb-2d416696eecd","9825ca23-52e7-5928-832d-642368ac833c","991bebdc-7a4e-5095-95ae-80778b6c9c22","abb45f16-c1bb-551f-8541-423e4508d55a","b3d8f581-4ad8-5a94-a1e1-a3239884c9c7","c1be5c3c-3f0c-5b25-9aec-0823dd1d9c0d","c5b42d17-7483-56a5-8676-d5cf70fef1a6","c7d5e0a2-9c32-5311-b42e-506fafdfe0f4","cd23126d-9f98-5c11-a27d-6b6529e18bc0","d41e5021-de07-569d-b133-c7e058c2f31b","d49a9810-9167-575b-8da1-dc803edb6ef0","d530d363-267b-5826-aeeb-b3f56a1e38bb","d6ff5fde-2f90-5534-bd13-991dde372dd8","f5f30fc8-0b27-5c44-b9b1-43250ae3ebf1"]},"subtypes":["Class"],"supertypes":[],"text":"(Gain the next level as a sorcery to add its ability.)\nYou have no maximum hand size.\n{2}{U}: Level 2\nWhen this Class becomes level 2, draw two cards.\n{4}{U}: Level 3\nWhenever you draw a card, put a +1/+1 counter on target creature you control.","type":"Enchantment — Class","types":["Enchantment"],"uuid":"0782d9db-3d58-5b57-9fca-8d213258f9a3"},{"artist":"Richard Kane Ferguson","artistIds":["191620ed-2361-444e-96a6-1fe7ce32ef3b"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["B","W"],"colors":["B","W"],"convertedManaCost":2.0,"edhrecRank":6522,"edhrecSaltiness":0.31,"finishes":["nonfoil"],"foreignData":[],"frameVersion":"2003","identifiers":{"cardKingdomId":"304443","cardsphereId":"128255","deckboxId":"95965","mcmId":"791464","mtgjsonV4Id":"2f86c9f1-fc95-5d9a-b690-923a8f0256fe","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"31813db2-cc97-4c68-8933-829d3b9e036d","scryfallIllustrationId":"95e31bea-e386-4451-b573-8ea101a20d0b","scryfallOracleId":"fc8247f5-f7b2-4fc4-a9ea-90babad5fa42","tcgplayerProductId":"582810"},"isAlternative":true,"isReprint":true,"language":"English","layout":"normal","legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","predh":"Legal","vintage":"Legal"},"manaCost":"{1}{W/B}","manaValue":2.0,"name":"Batwing Brume","number":"EVE-81","originalReleaseDate":"2024-08-02","printings":["ARC","EVE","PLST","SLD"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/763d3813409d326a","cardmarket":"https://mtgjson.com/links/997d7ef297a8d0e2","tcgplayer":"https://mtgjson.com/links/f206b180cdb73c26"},"rarity":"uncommon","rulings":[{"date":"2008-08-01","text":"If the spell is copied, the copy will never have had mana of the stated color paid for it, no matter what colors were spent on the original spell."},{"date":"2008-08-01","text":"The spell cares about what mana was spent to pay its total cost, not just what mana was spent to pay the hybrid part of its cost."},{"date":"2008-08-01","text":"The spell checks on resolution to see if any mana of the stated colors was spent to pay its cost. If so, it doesn’t matter how much mana of that color was spent."}],"setCode":"PLST","skuIds":{"nonfoil":"1f15ee57-f17b-54ac-a3d1-ce66c9d25b32"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"Prevent all combat damage that would be dealt this turn if {W} was spent to cast this spell. Each player loses 1 life for each attacking creature they control if {B} was spent to cast this spell. (Do both if {W}{B} was spent.)","type":"Instant","types":["Instant"],"uuid":"b99bf470-7544-52b3-a919-9fc787a68e8d","variations":["240e0041-24a3-58a0-8ff5-d4b774721a14"]},{"artist":"Steven Belledin","artistIds":["f07d73b9-52a0-4fe5-858b-61f7b42174a5"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["B","U"],"colors":["B"],"convertedManaCost":2.0,"edhrecRank":28911,"edhrecSaltiness":0.41,"finishes":["nonfoil"],"flavorText":"He scowls at his imperfect creation, then crushes it to scrap. He salvages the etherium and begins anew.","foreignData":[],"frameVersion":"2003","identifiers":{"cardKingdomId":"303692","cardsphereId":"128268","deckboxId":"95971","mcmId":"792666","mtgjsonV4Id":"cf0a7c23-2c6c-57ae-a567-545bca4ddd49","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"156a3751-a404-43ea-aa1e-21b19a809a11","scryfallIllustrationId":"48b2c417-b899-44c6-8588-67546e7589c9","scryfallOracleId":"06494c26-3822-43ee-bedf-611c9ec7cc6b","tcgplayerProductId":"582823"},"isReprint":true,"language":"English","layout":"normal","leadershipSkills":{"brawl":false,"commander":false,"oathbreaker":false,"pauper_commander":true,"predh":false},"legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","penny":"Legal","predh":"Legal","vintage":"Legal"},"manaCost":"{1}{B}","manaValue":2.0,"name":"Puppet Conjurer","number":"ALA-82","originalReleaseDate":"2024-08-02","power":"1","printings":["ALA","PLST"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/524908cceabd14c1","cardmarket":"https://mtgjson.com/links/17c96c9e94d5cf97","tcgplayer":"https://mtgjson.com/links/253a66373fc95bdd"},"rarity":"uncommon","relatedCards":{"tokens":["f11ebafa-5f5f-5ae3-9d32-a18e812e74b9"]},"rulings":[{"date":"2008-10-01","text":"If you control no Homunculi when the second ability resolves, nothing happens. There’s no penalty for failing to sacrifice a Homunculus."},{"date":"2008-10-01","text":"The Homunculus you sacrifice due to the second ability isn’t limited to being a Homunculus token put onto the battlefield by Puppet Conjurer."},{"date":"2008-10-01","text":"The only difference between a colored artifact and a colorless artifact is, obviously, its color. Unlike most artifacts, a colored artifact requires colored mana to cast. Also unlike most artifacts, a colored artifact has a color in all zones. It will interact with cards that care about color. Other than that, a colored artifact behaves just like any other artifact. It will interact as normal with any card that cares about artifacts, such as Shatter or Arcbound Ravager."}],"setCode":"PLST","skuIds":{"nonfoil":"60bea651-e706-5655-ae80-d21dc470ab47"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":["Human","Wizard"],"supertypes":[],"text":"{U}, {T}: Create a 0/1 blue Homunculus artifact creature token.\nAt the beginning of your upkeep, sacrifice a Homunculus.","toughness":"2","type":"Artifact Creature — Human Wizard","types":["Artifact","Creature"],"uuid":"ebb74038-e45c-503d-8c16-f14fa971e845"},{"artist":"Raymond Swanland","artistIds"