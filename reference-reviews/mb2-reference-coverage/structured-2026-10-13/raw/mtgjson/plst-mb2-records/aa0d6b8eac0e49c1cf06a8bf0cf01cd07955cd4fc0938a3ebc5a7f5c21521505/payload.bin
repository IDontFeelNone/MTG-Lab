22c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"Counter target noncreature spell. Its controller creates two Treasure tokens. (They're artifacts with \"{T}, Sacrifice this token: Add one mana of any color.\")","type":"Instant","types":["Instant"],"uuid":"cf9877f7-d146-58a9-b6e6-f233eebd1ed2"},{"artist":"Heonhwa","artistIds":["ce415f9e-8a20-4d64-bcba-2b1b7e94012e"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["U"],"colors":["U"],"convertedManaCost":3.0,"edhrecRank":1255,"edhrecSaltiness":0.34,"finishes":["nonfoil"],"flavorText":"\"Inform our allies in the Tenth and throw the circuit. It's about to get weird.\"","foreignData":[],"frameVersion":"2015","identifiers":{"cardKingdomId":"303659","cardsphereId":"127698","deckboxId":"95800","mcmId":"791971","mtgjsonV4Id":"e1e3ffa6-99e3-540f-8a86-39026862c2f1","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"26a679fa-cefc-4222-a12c-3ab886940956","scryfallIllustrationId":"df103fac-6d87-4a15-9f70-d9d5d035fb2b","scryfallOracleId":"83874e60-291b-47a7-ba9f-69437fa7e3c7","tcgplayerProductId":"581301"},"isReprint":true,"keywords":["Proliferate"],"language":"English","layout":"normal","leadershipSkills":{"brawl":false,"commander":false,"oathbreaker":false,"pauper_commander":true,"predh":false},"legalities":{"brawl":"Legal","commander":"Legal","competitivebrawl":"Legal","duel":"Legal","gladiator":"Legal","historic":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","pioneer":"Legal","timeless":"Legal","vintage":"Legal"},"manaCost":"{2}{U}","manaValue":3.0,"name":"Flux Channeler","number":"WAR-52","originalReleaseDate":"2024-08-02","power":"2","printings":["CMM","PLST","WAR"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/f7c462179dff4977","cardmarket":"https://mtgjson.com/links/c9e353a63656c580","tcgplayer":"https://mtgjson.com/links/e507550d2db4fd73"},"rarity":"uncommon","rulings":[{"date":"2019-05-03","text":"Flux Channeler's ability resolves before the spell that caused it to trigger. It resolves even if that spell is countered."},{"date":"2023-02-04","text":"An ability that triggers \"Whenever you proliferate\" triggers even if you chose no permanents or players while doing so."},{"date":"2023-02-04","text":"If a permanent ever has both +1/+1 counters and -1/-1 counters on it at the same time, they're removed in pairs as a state-based action so that the permanent has only one of those kinds of counters on it."},{"date":"2023-02-04","text":"If a player or permanent has more than one kind of counter on it, and you choose for it to get additional counters, it must get one of each kind of counter it already has. You can't have it get just one kind of counter it already has and not the others."},{"date":"2023-02-04","text":"Players can respond to a spell or ability whose effect includes proliferating. Once that spell or ability starts to resolve, however, and its controller chooses which permanents and players will get new counters, it's too late for anyone to respond."},{"date":"2023-02-04","text":"To proliferate, you can choose any permanent that has a counter, including ones controlled by opponents. You can choose any player who has a counter, including opponents. You can't choose cards in any zone other than the battlefield, even if they have counters on them."},{"date":"2023-02-04","text":"You don't have to choose every permanent or player that has a counter, only the ones you want to add another counter to. Since \"any number\" includes zero, you don't have to choose any permanents at all, and you don't have to choose any players at all."}],"setCode":"PLST","skuIds":{"nonfoil":"e7179d57-a1c3-55af-b228-6129e9ba9c89"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":["Human","Wizard"],"supertypes":[],"text":"Whenever you cast a noncreature spell, proliferate. (Choose any number of permanents and/or players, then give each another counter of each kind already there.)","toughness":"2","type":"Creature — Human Wizard","types":["Creature"],"uuid":"a7744332-a393-508f-baeb-a370dccca2d9"},{"artist":"Titus Lunter","artistIds":["b11e6b3a-f4ca-4cf1-8fd7-475696de5f5c"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["U"],"colors":["U"],"convertedManaCost":4.0,"edhrecRank":31956,"edhrecSaltiness":0.14,"finishes":["nonfoil"],"flavorText":"\"There is nothing so free as the spring river born of winter's ice.\"\n—Nitula, the Hunt Caller","foreignData":[],"frameVersion":"2015","identifiers":{"cardKingdomId":"303515","cardsphereId":"128020","deckboxId":"95804","mtgjsonV4Id":"0e4caa45-e839-595c-b765-b6dcca6db4e1","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"06761942-2135-438c-99ba-7d20221c7c77","scryfallIllustrationId":"4e410cc2-b5b1-46e6-ab84-4eed594195c3","scryfallOracleId":"9d49cef5-8f9c-46cd-aa5e-7861fc1dcaa4","tcgplayerProductId":"582568"},"isReprint":true,"language":"English","layout":"normal","leadershipSkills":{"brawl":false,"commander":false,"oathbreaker":false,"pauper_commander":true,"predh":false},"legalities":{"brawl":"Legal","commander":"Legal","competitivebrawl":"Legal","duel":"Legal","gladiator":"Legal","historic":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","penny":"Legal","pioneer":"Legal","timeless":"Legal","vintage":"Legal"},"manaCost":"{2}{U}{U}","manaValue":4.0,"name":"Scion of Glaciers","number":"KTK-53","originalReleaseDate":"2024-08-02","power":"2","printings":["KTK","PLST"],"purchaseUrls":{"cardKingdom":"