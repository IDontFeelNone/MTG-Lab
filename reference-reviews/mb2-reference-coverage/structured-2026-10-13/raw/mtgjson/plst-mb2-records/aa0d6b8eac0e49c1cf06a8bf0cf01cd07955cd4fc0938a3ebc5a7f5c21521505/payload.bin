3.0,"name":"Skullport Merchant","number":"AFR-120","originalReleaseDate":"2024-08-02","power":"1","printings":["AFR","CLB","HBG","PLST"],"producedMana":["B","G","R","U","W"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/78a2652b2e1d403e","tcgplayer":"https://mtgjson.com/links/5eec9fd8d9b8e9cc"},"rarity":"uncommon","relatedCards":{"tokens":["b0e0f943-429b-5075-a61d-22338c7dfcf6"]},"setCode":"PLST","skuIds":{"nonfoil":"a79903cc-8425-5194-9ce5-8308f9b30a03"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":["Dwarf","Citizen"],"supertypes":[],"text":"When this creature enters, create a Treasure token. (It's an artifact with \"{T}, Sacrifice this token: Add one mana of any color.\")\n{1}{B}, Sacrifice another creature or a Treasure: Draw a card.","toughness":"4","type":"Creature — Dwarf Citizen","types":["Creature"],"uuid":"1e944780-dc78-58ce-91f2-648bb32ea043"},{"artist":"Justine Cruz","artistIds":["4d6acc42-7bac-42cb-ac57-a56355292e89"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["B"],"colors":["B"],"convertedManaCost":2.0,"edhrecRank":3857,"edhrecSaltiness":0.15,"finishes":["nonfoil"],"flavorText":"Restricted auctions are held once a year at the Dragon's Lair—the sacred, neutral meeting ground of all Reckoner gangs.","foreignData":[],"frameVersion":"2015","identifiers":{"cardKingdomId":"303821","cardsphereId":"128278","deckboxId":"96178","mtgjsonV4Id":"d03eed1c-c29b-5714-b866-56b357d7d155","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"4e02b30f-1bd2-479d-8602-c3df9ba0d3d4","scryfallIllustrationId":"708147ab-48cc-4719-b513-1939df5252ac","scryfallOracleId":"044ea111-ce87-49ab-98f7-ae8447f48ac5","tcgplayerProductId":"582833"},"isReprint":true,"language":"English","layout":"normal","legalities":{"brawl":"Legal","commander":"Legal","competitivebrawl":"Legal","duel":"Legal","gladiator":"Legal","historic":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","pauper":"Legal","paupercommander":"Legal","pioneer":"Legal","timeless":"Legal","vintage":"Legal"},"manaCost":"{1}{B}","manaValue":2.0,"name":"Reckoner's Bargain","number":"NEO-120","originalReleaseDate":"2024-08-02","printings":["NEO","PLST"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/3dc732a5c6c7c09d","tcgplayer":"https://mtgjson.com/links/c267a5aead8b5a4b"},"rarity":"common","setCode":"PLST","skuIds":{"nonfoil":"f96da637-7960-5e45-a1a3-6dccfa850346"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"As an additional cost to cast this spell, sacrifice an artifact or creature.\nYou gain life equal to the sacrificed permanent's mana value. Draw two cards.","type":"Instant","types":["Instant"],"uuid":"9ab393dc-6cc1-5372-bd1b-1efbf9d4d68b"},{"artist":"John Avon","artistIds":["798f3932-30e0-4420-aa3f-db4d613f89ca"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["G"],"colors":["G"],"convertedManaCost":5.0,"edhrecRank":25671,"edhrecSaltiness":0.12,"finishes":["nonfoil"],"flavorText":"It's hard to be humble when the whole world is bite size.","foreignData":[],"frameVersion":"1997","identifiers":{"cardKingdomId":"304376","cardsphereId":"128238","deckboxId":"96181","mcmId":"791425","mtgjsonV4Id":"3ec11621-280f-5d90-bafc-363a029ae8a5","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"387c75fd-e808-456a-a236-625fee816d06","scryfallIllustrationId":"d6e37369-5b93-474e-92a7-d0e5afe384af","scryfallOracleId":"dc7f0c33-80ea-453e-a237-473f077f038e","tcgplayerProductId":"582793"},"isReprint":true,"keywords":["Madness","Trample"],"language":"English","layout":"normal","leadershipSkills":{"brawl":false,"commander":false,"oathbreaker":false,"pauper_commander":true,"predh":false},"legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","oathbreaker":"Legal","pauper":"Legal","paupercommander":"Legal","penny":"Legal","predh":"Legal","premodern":"Legal","vintage":"Legal"},"manaCost":"{3}{G}{G}","manaValue":5.0,"name":"Arrogant Wurm","number":"TOR-120","originalReleaseDate":"2024-08-02","power":"4","printings":["F06","PLST","PRM","TOR","VMA","WC03"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/884c70aaa9e0ac30","cardmarket":"https://mtgjson.com/links/1c09c1795b0a2ec0","tcgplayer":"https://mtgjson.com/links/d5b3db67edc76497"},"rarity":"uncommon","rulings":[{"date":"2022-12-08","text":"A card with madness that's discarded counts as having been discarded even though it's put into exile rather than a graveyard. If it was discarded to pay a cost, that cost is still paid. Abilities that trigger when a card is discarded will still trigger."},{"date":"2022-12-08","text":"A spell cast for its madness cost is put onto the stack like any other spell. It can be countered, copied, and so on. As it resolves, it's put onto the battlefield if it's a permanent card or into its owner's graveyard if it's an instant or sorcery card."},{"date":"2022-12-08","text":"Cards are discarded in a Magic game only from a player's hand. Effects that put cards into a player's graveyard from anywhere else do not cause those cards to be discarded."},{"date":"2022-12-08","text":"Casting a spell with madness ignores the timing rules based on the card's card type. For example, you can cast a sorcery with madness if you discard it during an opponent's turn."},{"date":"2022-12-08","text":"If you choose not to cast a card with madness when the madness triggered ability resolves, it's put into your graveyard. Madness doesn't give you another chance to cast it later."},{"date":"2022-12-08","text":"If you discard a card with madness to pay the cost of a spell or activated ability, that card's madness triggered ability (and the spell that card becomes, if you choose to cast it) will resolve before the spell or ability the discard paid for."},{"date":"2022-12-08","text":"If you discard a card with madness while a spell or ability is resolving, it moves immediately to exile. Continue resolving that spell or ability, noting that the card you discarded is not in your graveyard at this time. Its madness triggered ability will be placed onto the stack once that spell or ability has completely resolved."},{"date":"2022-12-08","text":"Madness works independently of why you're discarding the card. You could discard it to pay a cost, because a spell or ability tells you to, or because you have too many cards in your hand during your cleanup step. You can't discard a card with madness just because you want to, though."},{"date":"2022-12-08","text":"To determine the total cost of a spell, start with the mana cost or alternative cost (such as a madness cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell is determined by only its mana cost, no matter what the total cost to cast that spell was."}],"setCode":"PLST","skuIds":{"nonfoil":"ea25d66f-6b86-5f62-9756-0731cff9c1a5"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":["Wurm"],"supertypes":[],"text":"Trample\nMadness {2}{G} (If you discard this card, discard it into exile. When you do, cast it for its madness cost or put it into your graveyard.)","toughness":"4","type":"Creature — Wurm","types":["Creature"],"uuid":"940e7b0b-2db3-586c-bcfb-a386ead5fe77"},{"artist":"Craig J Spearing","artistIds":["b0f15e74-0dd6-4156-959e-c5e30c5cdc52"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["G"],"colors":["G"],"convertedManaCost":1.0,"edhrecRank":6746,"edhrecSaltiness":0.21,"finishes":["nonfoil"],"flavorText":"\"What a move! Lorehold gets caught flat-footed, and Witherbloom barrels ahead.\"\n—Cremik, Mage Tower commentator","foreignData":[],"frameVersion":"2015","identifiers":{"cardKingdomId":"304358","cardsphereId":"128350","deckboxId":"96198","mcmId":"791573","mtgjsonV4Id":"b6d3d67b-ba85-5e2e-a6eb-e81faaa6e6ac","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"4e083cc9-e3df-4226-a842-1d6303d0faa6","scryfallIllustrationId":"0b9ee4eb-cabd-4d96-b5af-015ca72b123e","scryfallOracleId":"7e24b4da-9728-43a0-8af4-f513a3e1104b","tcgplayerProductId":"582905"},"isReprint":true,"language":"English","layout":"normal","legalities":{"brawl":"Legal","commander":"Legal","competitivebrawl":"Legal","duel":"Legal","gladiator":"Legal","historic":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","pauper":"Legal","paupercommander":"Legal","pioneer":"Legal","timeless":"Legal","vintage":"Legal"},"manaCost":"{G}","manaValue":1.0,"name":"Charge Through","number":"STX-124","originalReleaseDate":"2024-08-02","printings":["PLST","STX"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/33b2d530270b044a","cardmarket":"https://mtgjson.com/links/0254258e6a5eded9","tcgplayer":"https://mtgjson.com/links/0f66f0df5970dc89"},"rarity":"common","rulings":[{"date":"2021-04-16","text":"If the target becomes illegal before Charge Through resolves (perhaps because an opponent des