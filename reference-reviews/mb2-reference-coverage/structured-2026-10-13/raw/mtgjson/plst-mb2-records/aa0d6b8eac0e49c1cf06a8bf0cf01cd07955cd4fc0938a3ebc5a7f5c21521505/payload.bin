ardKingdomId":"304349","cardsphereId":"128742","deckboxId":"96238","mtgjsonV4Id":"b2f05b47-77b7-5d3f-b7cc-c0e71d296289","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"a6f58afe-21a1-4a9a-89ed-907d323e9780","scryfallIllustrationId":"bea07731-27f3-4a14-b2bc-0f20dc2f84fc","scryfallOracleId":"6f5d31d1-3493-4d1b-bbf9-1726e47507db","tcgplayerProductId":"583301"},"isReprint":true,"language":"English","layout":"normal","legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","penny":"Legal","predh":"Legal","vintage":"Legal"},"manaCost":"{2/G}{2/G}{2/G}","manaValue":6.0,"name":"Tower Above","number":"SHM-131","originalReleaseDate":"2024-08-02","printings":["PLST","SHM"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/2c7c63530f66fcb0","tcgplayer":"https://mtgjson.com/links/79627da8fb4d5dfd"},"rarity":"uncommon","rulings":[{"date":"2008-05-01","text":"A card with a monocolored hybrid mana symbol in its mana cost is each of the colors that appears in its mana cost, regardless of what mana was spent to cast it. Thus, Tower Above is green even if you spend six white mana to cast it."},{"date":"2008-05-01","text":"A card with monocolored hybrid mana symbols in its mana cost has a mana value equal to the highest possible cost it could be cast for. Its mana value never changes. Thus, Tower Above has a mana value of 6, even if you spend {G}{G}{G} to cast it."},{"date":"2008-05-01","text":"If a cost includes more than one monocolored hybrid mana symbol, you can choose a different way to pay for each symbol. For example, you can pay for Tower Above by spending {G}{G}{G}, {2}{G}{G}, {4}{G}, or {6}."},{"date":"2008-05-01","text":"If an effect reduces the cost to cast a spell by an amount of generic mana, it applies to a monocolored hybrid spell only if you've chosen a method of paying for it that includes generic mana."},{"date":"2008-05-01","text":"When the creature affected by Tower Above attacks, you can target any creature on the battlefield with the triggered ability. However, if the creature you target can't block the creature affected by Tower Above (for example, because the attacking creature has flying and the other one doesn't, or because both creatures are controlled by the same player), the triggered ability does nothing. In that case, the creature you targeted is free to block whichever creature its controller chooses, or block no creatures at all."}],"setCode":"PLST","skuIds":{"nonfoil":"21cc46bb-6118-53a0-b904-9492fe10f206"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"({2/G} can be paid with any two mana or with {G}. This card's mana value is 6.)\nUntil end of turn, target creature gets +4/+4 and gains trample, wither, and \"When this creature attacks, target creature blocks it this turn if able.\" (It deals damage to creatures in the form of -1/-1 counters.)","type":"Sorcery","types":["Sorcery"],"uuid":"5a1437e8-d382-5764-a6a0-663a84870205"},{"artist":"April Prime","artistIds":["266f773b-5c80-4803-9b95-5a985af90548"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["R"],"colors":["R"],"convertedManaCost":2.0,"edhrecRank":5129,"edhrecSaltiness":0.17,"finishes":["nonfoil"],"foreignData":[],"frameVersion":"2015","identifiers":{"cardKingdomId":"303924","cardsphereId":"129344","mcmId":"791459","mtgjsonV4Id":"ae34a656-ca5a-53fa-ab12-6e6e551be073","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"2a17c97b-1195-4ca7-aa30-fe11585f180c","scryfallIllustrationId":"63956149-78e5-4784-835e-018a949d87fa","scryfallOracleId":"e74c400