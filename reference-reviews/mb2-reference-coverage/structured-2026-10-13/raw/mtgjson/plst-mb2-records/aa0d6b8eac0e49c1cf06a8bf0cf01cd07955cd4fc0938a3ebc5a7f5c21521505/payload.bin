gnData":[],"frameVersion":"2003","identifiers":{"cardKingdomId":"304127","cardsphereId":"128780","deckboxId":"96337","mcmId":"791991","mtgjsonV4Id":"bc35c9f9-aa4e-5ff9-9a26-2ef976ac523c","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"ccf06e21-b0fb-4fb4-9f3f-c4e721b3cb6f","scryfallIllustrationId":"2fcca987-364c-4738-a75b-099d8a26d614","scryfallOracleId":"44623693-51d6-49ad-8cd7-140505caf02f","tcgplayerProductId":"583339"},"isReprint":true,"language":"English","layout":"normal","leadershipSkills":{"brawl":false,"commander":false,"oathbreaker":false,"pauper_commander":true,"predh":false},"legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","predh":"Legal","vintage":"Legal"},"manaCost":"{5}{R}","manaValue":6.0,"name":"Fury Sliver","number":"TSP-157","originalReleaseDate":"2024-08-02","power":"3","printings":["H09","PLST","SLD","TSP","TSR"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/7e6864c1b8dc0206","cardmarket":"https://mtgjson.com/links/c1e87d24e65a5de3","tcgplayer":"https://mtgjson.com/links/e35edee194985b9e"},"rarity":"uncommon","rulings":[{"date":"2013-07-01","text":"Abilities that Slivers grant, as well as power/toughness boosts, are cumulative. However, for some abilities, like flying, having more than one instance of the ability doesn't provide any additional benefit."},{"date":"2013-07-01","text":"If the creature type of a Sliver changes so it's no longer a Sliver, it will no longer be affected by its own ability. Its ability will continue to affect other Sliver creatures."},{"date":"2021-03-19","text":"If a creature loses double strike after assigning damage in the first strike combat damage step (due to Fury Sliver leaving the battlefield, for example), that creature won't assign damage in the normal combat damage step."}],"setCode":"PLST","skuIds":{"nonfoil":"82ba7e3d-a7a2-5317-837d-9db1b2cfe420"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1