 Parente","artistIds":["d48dd097-720d-476a-8722-6a02854ae28b"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["R"],"colors":["R"],"convertedManaCost":4.0,"edhrecRank":24906,"edhrecSaltiness":0.07,"finishes":["nonfoil"],"foreignData":[],"frameVersion":"2003","identifiers":{"cardKingdomId":"303956","cardsphereId":"128372","deckboxId":"95932","mcmId":"791446","mtgjsonV4Id":"a1f018f6-1e47-53d5-8346-b3d698772696","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"dd2fae44-543c-4895-8950-56a21c9a6c40","scryfallIllustrationId":"aaa201ad-06fe-4506-b08f-dcadb221c477","scryfallOracleId":"f73d1525-ab0b-4772-9dfa-66e1c84c3ea4","tcgplayerProductId":"582927"},"isReprint":true,"language":"English","layout":"normal","leadershipSkills":{"brawl":false,"commander":false,"oathbreaker":false,"pauper_commander":true,"predh":false},"legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","predh":"Legal","vintage":"Legal"},"manaCost":"{3}{R}","manaValue":4.0,"name":"Balduvian Warlord","number":"CSP-77","originalReleaseDate":"2024-08-02","power":"3","printings":["CSP","PLST"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/e6f752a461e9afa4","cardmarket":"https://mtgjson.com/links/f259aa69ef97bfa5","tcgplayer":"https://mtgjson.com/links/74fe1fd4bf0a9c4b"},"rarity":"uncommon","rulings":[{"date":"2006-07-15","text":"Balduvian Warlord’s ability may be activated during any player’s turn."},{"date":"2006-07-15","text":"If an attacking creature becomes unblocked this way and remains unblocked, it will deal its combat damage to the defending player. Abilities that say “When this creature attacks and isn’t blocked” won’t trigger."},{"date":"2006-07-15","text":"If an attacking creature has a “When this creature becomes blocked by [a creature]” ability, it triggers when a creature blocks it due to the Warlord’s ability."},{"date":"2006-07-15","text":"If an attacking creature has an ability that triggers “When this creature becomes blocked,” it triggers when a creature blocks it due to the Warlord’s ability only if it was unblocked at that point."},{"date":"2006-07-15","text":"If the targeted creature has a “When this creature blocks” ability, it will trigger when Balduvian Warlord’s ability resolves and the creature blocks again."},{"date":"2006-07-15","text":"The attacking creature will become unblocked only if the targeted creature was the only one that blocked it this combat, even if all the other creatures that were blocking it are no longer on the battlefield or are no longer blocking it (even those removed with other Balduvian Warlords’ abilities)."},{"date":"2006-07-15","text":"The targeted creature that’s removed from combat may then block the attacking creature that it was originally blocking. If so, that creature will no longer be unblocked."}],"setCode":"PLST","skuIds":{"nonfoil":"71dabebf-e688-527a-9491-62f7589f5d60"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":["Human","Barbarian"],"supertypes":[],"text":"{T}: Remove target blocking creature from combat. Creatures it was blocking that hadn't become blocked by another creature this combat become unblocked, then it blocks an attacking creature of your choice. Activate only during the declare blockers step.","toughness":"2","type":"Creature — Human Barbarian","types":["Creature"],"uuid":"ceb9a71e-10a7-54e2-9f18-4e3cb6e5e6e5"},{"artist":"Scott Kirschner","artistIds":["a9199ae8-9891-4366-bf5b-42cfb662d840"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["R"],"colors":["R"],"convertedManaCost":3.0,