d":"96654","mtgjsonV4Id":"0f6c2970-ee70-5911-9fbb-fd30d28d9ca2","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"e8b6b2e3-82eb-4374-a098-98d93da4ebef","scryfallIllustrationId":"75f184b2-3e07-4a1b-b568-0c463f41156f","scryfallOracleId":"c77ff526-c0a8-45c7-9730-2e306a0d01b8","tcgplayerProductId":"582479"},"isReprint":true,"keywords":["Enchant"],"language":"English","layout":"normal","legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","pauper":"Legal","paupercommander":"Legal","predh":"Legal","premodern":"Legal","vintage":"Legal"},"manaCost":"{W}","manaValue":1.0,"name":"Spirit Link","number":"10E-45","originalReleaseDate":"2024-08-02","printings":["10E","4BB","4ED","5ED","6ED","7ED","8ED","9ED","DMR","LEG","PLST","PSAL","REN","WC98"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/70786eb7710fa721","tcgplayer":"https://mtgjson.com/links/dd981dfa007c371e"},"rarity":"uncommon","rulings":[{"date":"2022-12-08","text":"The triggered ability triggers when the enchanted creature deals any damage, not only combat damage."},{"date":"2022-12-08","text":"Unlike the lifelink ability, the ability of Spirit Link is a triggered ability that goes on the stack and may be responded to. Notably, if the enchanted creature deals damage at the same time you’re dealt enough damage to reduce your life total to 0 or less, you’ll lose the game before you can gain any life."}],"setCode":"PLST","skuIds":{"nonfoil":"58998cbe-5873-5d8d-930a-f83ca43e76de"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":["Aura"],"supertypes":[],"text":"Enchant creature (Target a creature as you cast this. This card enters attached to that creature.)\nWhenever enchanted creature deals damage, you gain that much life.","type":"Enchantment — Aura","types":["Enchantment"],"uuid":"2690f18c-64e9-5650-8813-5ead40f3ae18"},{"artist":"Sidharth Chaturvedi","artistIds":["55e6d846-2f73-4fba-9b88-441686bb8dcb"],"availability":["paper"],"borderColor":"black","colorIdentity":["G","W"],"colors":["G","W"],"convertedManaCost":4.0,"edhrecRank":3110,"edhrecSaltiness":0.15,"finishes":["nonfoil"],"flavorText":"There are no soloists in the chorus of Selesnya.","foreignData":[],"frameEffects":["legendary"],"frameVersion":"2015","identifiers":{"cardKingdomId":"304453","cardsphereId":"128567","deckboxId":"96657","mtgjsonV4Id":"b37d67ca-3d03-5690-a707-a51f432b0934","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"c2649bc6-2ed9-4d50-ad11-ae05d6df2c3d","scryfallIllustrationId":"893c51a5-7795-4398-823c-077e9adf8930","scryfallOracleId":"e94ef397-f5c5-4b8d-ae27-528352fa1d1e","tcgplayerProductId":"583123"},"isReprint":true,"keywords":["Populate"],"language":"English","layout":"normal","leadershipSkills":{"brawl":false,"commander":true,"oathbreaker":false,"pauper_commander":false,"predh":false},"legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","penny":"Legal","pioneer":"Legal","vintage":"Legal"},"manaCost":"{G}{G}{W}{W}","manaValue":4.0,"name":"Trostani, Selesnya's Voice","number":"GK1-102","originalReleaseDate":"2024-08-02","power":"2","printings":["C19","GK1","PLST","RTR","SLD"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/5509fa0b2cc76872","tcgplayer":"https://mtgjson.com/links/552c23c3fdfab24f"},"rarity":"mythic","rulings":[{"date":"2012-10-01","text":"Trostani's first ability checks the creature's toughness as it resolves. If that creature has left the battlefield, use its toughness from when it was last on the battlefield. You can't lose life this way if that creature's toughness was less than 0."},{"date":"2024-01-12","text":"Any enters-the-battlefield abilities of the copied token will trigger when the new token enters the battlefield. Any \"as [this creature] enters the battlefield\" or \"[this creature] enters the battlefield with\" abilities of the copied token will also work."},{"date":"2024-01-12","text":"If you choose to copy a creature token that's a copy of another creature, the new creature token will copy the characteristics of whatever the original token is copying."},{"date":"2024-01-12","text":"If you control no creature tokens when you populate, nothing will happen."},{"date":"2024-01-12","text":"Populate doesn't target the creature token you're copying. You choose that creature token as you're taking the populate action. You can choose any creature token you control. If a spell or ability causes you to create a creature token and then instructs you to populate, you may choose to copy the token you just created, or you may choose to copy another creature token you control."},{"date":"2024-01-12","text":"The new creature token copies the characteristics of the original token as stated by the effect that created the original token."},{"date":"2024-01-12","text":"The new token doesn't copy whether the original token is tapped or untapped, whether it has any counters on it or Auras and Equipment attached to it, or any noncopy effects that have changed its power, toughness, color, and so on."}],"securityStamp":"oval","setCode":"PLST","skuIds":{"nonfoil":"6fe14060-99b5-549f-a2e2-3694e507a708"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":["Dryad"],"supertypes":["Legendary"],"text":"Whenever another cr