d-4636-9e82-8c27447861f7","scryfallId":"8cf1402d-6506-4c33-b069-700741a6df81","scryfallIllustrationId":"e4671eb9-f3b3-4fca-982f-3881bec0a612","scryfallOracleId":"ad0070db-6454-41cb-861f-8f5b8fc2a3b8","tcgplayerProductId":"581318"},"isReprint":true,"language":"English","layout":"normal","legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","pauper":"Legal","paupercommander":"Legal","vintage":"Legal"},"manaCost":"{2}{U}","manaValue":3.0,"name":"Ghostly Flicker","number":"KHC-39","originalReleaseDate":"2024-08-02","printings":["AVR","CMM","KHC","MM3","PLST","SLD","SLZ"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/e80dd494faad2afe","cardmarket":"https://mtgjson.com/links/77167cac118686c4","tcgplayer":"https://mtgjson.com/links/1d62e64740718a49"},"rarity":"common","rulings":[{"date":"2017-03-14","text":"The two targets can have different card types. For example, you can target one artifact and one creature with Ghostly Flicker."}],"setCode":"PLST","skuIds":{"nonfoil":"c9ac9916-78c5-5609-be3b-046426672004"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"Exile two target artifacts, creatures, and/or lands you control, then return those cards to the battlefield under your control.","type":"Instant","types":["Instant"],"uuid":"76843ba9-de32-5492-8afc-612d8f63dc4b"},{"artist":"Andrew Goldhawk","artistIds":["f4a65a04-9e2e-4541-8d0e-f34e9517f092"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["B"],"colors":["B"],"convertedManaCost":3.0,"edhrecRank":29863,"edhrecSaltiness":0.12,"finishes":["nonfoil"],"foreignData":[],"frameVersion":"1997","identifiers":{"cardsphereId":"128035","deckboxId":"95726","mcmId":"791509","mtgjsonV4Id":"d49bd4f0-7910-58b2-98e4-9d24782a1049","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"0bf0c178-afb8-4265-848e-72c4a9821a3f","scryfallIllustrationId":"b945cc46-ac0a-4c05-94d0-1f396ba16f80","scryfallOracleId":"8574f57a-768d-42a0-ac8c-cc0a1de181e0","tcgplayerProductId":"582590"},"isReprint":true,"keywords":["Kicker"],"language":"English","layout":"normal","legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","oathbreaker":"Legal","pauper":"Legal","paupercommander":"Legal","penny":"Legal","predh":"Legal","premodern":"Legal","vintage":"Legal"},"manaCost":"{2}{B}","manaValue":3.0,"name":"Bog Down","number":"PLS-39","originalReleaseDate":"2024-08-02","printings":["PLS","PLST"],"purchaseUrls":{"cardmarket":"https://mtgjson.com/links/bb2fb68fac1403fd","tcgplayer":"https://mtgjson.com/links/3ad50fdadcd03c75"},"rarity":"common","rulings":[{"date":"2004-10-04","text":"The player discards 2 cards or 3 cards, not 5 cards."},{"date":"2024-11-08","text":"If a card or token enters as a copy of a permanent, the new permanent isn't kicked, even if the original was."},{"date":"2024-11-08","text":"If a spell's kicker cost was paid, the spell is \"kicked.\""},{"date":"2024-11-08","text":"If you copy a kicked spell on the stack, the copy is also kicked. If the copied spell is a permanent spell, the token the copy of that spell becomes when it enters is also kicked."},{"date":"2024-11-08","text":"If you put a permanent with a kicker ability onto the battlefield without casting it, you can't kick it."},{"date":"2024-11-08","text":"The kicker ability doesn't let you pay a kicker cost more than once."},{"date":"2024-11-08","text":"To determine a spell's total cost, start with the mana cost (or an alternative cost if another card's effect allows you to pay one instead), add any cost increases (such as kicker), then apply any cost reductions. The spell's mana value remains unchanged, no matter what the total cost to cast it was."}],"setCode":"PLST","skuIds":{"nonfoil":"edb4f49a-bf94-5b39-9c2b-8d6c76696ce1"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"Kicker—Sacrifice two lands. (You may sacrifice two lands in addition to any other costs as you cast this spell.)\nTarget player discards two cards. If this spell was kicked, that player discards three cards instead.","type":"Sorcery","types":["Sorcery"],"uuid":"712c68e1-40de-50ad-aef4-ca396d483e1a"},{"artist":"Ben Thompson","artistIds":["f3116c88-57f4-4fd1-95f3-cfd163977661"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["U"],"colors":["U"],"convertedManaCost":2.0,"edhrecRank":21323,"edhrecSaltiness":0.0,"finishes":["nonfoil"],"foreignData":[],"frameEffects":["tombstone"],"frameVersion":"1997","identifiers":{"cardKingdomId":"303507","cardsphereId":"127695","deckboxId":"95731","mcmId":"791963","mtgjsonV4Id":"8e0a2e3f-85a8-508c-961d-60d3ed7c8347","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"06c69319-ce8f-4b4c-bbf4-11e376e2f712","scryfallIllustrationId":"8996eee4-0187-4f51-a393-13ff73625471","scryfallOracleId":"9196c8dc-bca6-4c35-949e-8c14a699a41d","tcgplayerProductId":"581297"},"isReprint":true,"keywords":["Flashback"],"language":"English","layout":"normal","legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","oathbreaker":"Legal","predh":"Legal","premodern":"Legal","vintage":"Legal"},"manaCost":"{X}{1}{U}","manaValue":2.0,"name":"Flash of Insight","number":"JUD-40","originalReleaseDate":"2024-08-02","printings":["JUD","PLST"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/520d5eef67fa34b3","cardmarket":"https://mtgjson.com/links/1c3d08060212869e","tcgplayer":"https://mtgjson.com/links/74948538d76e2591"},"rarity":"uncommon","rulings":[{"date":"2021-03-19","text":"\"Flashback [cost]\" means \"You may cast this card from your graveyard by paying [cost] rather than paying its mana cost\" and \"If the flashback cost was paid, exile this card instead of putting it anywhere else any time it would leave the stack.\""},{"date":"2021-03-19","text":"A spell cast using flashback will always be exiled afterward, whether it resolves, is countered, or leaves the stack in some other way."},{"date":"2021-03-19","text":"If a card with flashback is put into your graveyard during your turn, you can cast it if it's legal to do so before any other player can take any actions."},{"date":"2021-03-19","text":"To determine the total cost of a spell, start with the mana cost or alternative cost (such as a flashback cost) you're paying, add any cost increases, then apply any cost reductions. The mana value of the spell is determined only by its mana cost, no matter what the total cost to cast the spell was."},{"date":"2021-03-19","text":"You can cast a spell using flashback even if it was somehow put into your graveyard without having been cast."},{"date":"2021-03-19","text":"You must still follow any timing restrictions and permissions, including those based on the card's type. For instance, you can cast a sorcery using flashback only when you could normally cast a sorcery."}],"setCode":"PLST","skuIds":{"nonfoil":"ecc904ed-a7dd-5886-b421-e3a26d9c609e"},"sourceProducts":{"nonfoil":["079afeee-9345-5b19-b902-d8d1725bfa45","1db93605-0a4e-5e5b-80a2-18a6e177f51d","3ccdf5f7-6548-57af-9e1c-a639100d1925","4cd5a7ce-3fb8-5780-a618-78d39c097a15","4f08144d-2ac5-5f6a-8606-7e05a3a27e02","84faf770-a5ed-51c1-922c-71ae2146ebed","90ce6f46-5779-57ee-9dc4-e293d6bc905f","abb45f16-c1bb-551f-8541-423e4508d55a","c5b42d17-7483-56a5-8676-d5cf70fef1a6"]},"subtypes":[],"supertypes":[],"text":"Look at the top X cards of your library. Put one of them into your hand and the rest on the bottom of your library in any order.\nFlashback—{1}{U}, Exile X blue cards from your graveyard. (You may cast this card from your graveyard for its flashback cost, then exile it. You can't exile Flash of Insight to pay for its own flashback cost.)","type":"Instant","types":["Instant"],"uuid":"85a41d79-df45-5d21-8f03-21adf6c2844d"},{"artist":"Jim Murray","artistIds":["1c906f9b-5bbe-4643-8f5c-90eb1c7f0c43"],"availability":["paper"],"boosterTypes":["default"],"borderColor":"black","colorIdentity":["U"],"colors":["U"],"convertedManaCost":2.0,"edhrecRank":6600,"edhrecSaltiness":0.26,"finishes":["nonfoil"],"flavorText":"He's mastered the art of sleight of land.","foreignData":[],"frameVersion":"2003","identifiers":{"cardKingdomId":"303588","cardsphereId":"127675","deckboxId":"95732","mcmId":"791857","mtgjsonV4Id":"99d0032d-811a-59ae-ae27-8c4abf504709","scryfallCardBackId":"0aeebaf5-8c7d-4636-9e82-8c27447861f7","scryfallId":"4fdb8b9d-9b4f-48c6-9651-7937aaf15282","scryfallIllustrationId":"89b059e4-0103-4531-87f3-05df3130db6e","scryfallOracleId":"c2550f1a-b662-43e7-a0b2-843025739a8f","tcgplayerProductId":"581277"},"isReprint":true,"language":"English","layout":"normal","legalities":{"commander":"Legal","duel":"Legal","legacy":"Legal","modern":"Legal","oathbreaker":"Legal","pauper":"Legal","paupercommander":"Legal","predh":"Legal","vintage":"Legal"},"manaCost":"{1}{U}","manaValue":2.0,"name":"Dreamscape Artist","number":"PLC-40","originalReleaseDate":"2024-08-02","power":"1","printings":["PLC","PLST","TSR","UMA"],"purchaseUrls":{"cardKingdom":"https://mtgjson.com/links/f0065eef9f8fda4e","cardmarket":"https://mtgjson.com/links/0bf3b992ed7d70f9","tcgplayer":"https://mtgjson.com/links/205f9e52f44cd21c"},"rarity":"common","setCode":"PLST","skuIds":{"nonfoil":"36b0792c-3a0e-572b-a87e-b9eca294b61f"},