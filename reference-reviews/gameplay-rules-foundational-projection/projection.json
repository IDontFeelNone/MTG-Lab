"PROJECTED"},{"rule_reference":"104.3a","status":"UNRESOLVED"},{"rule_reference":"111.2","status":"UNRESOLVED"},{"rule_reference":"112.2","status":"UNRESOLVED"},{"rule_reference":"113.10","status":"UNRESOLVED"},{"rule_reference":"407","status":"UNRESOLVED"},{"rule_reference":"109.4a","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"109.4b","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"109.4c","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"109.4d","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"109.4e","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"109.4f","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"109.4g","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7a","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7b","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7c","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7d","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7e","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7f","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7g","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7h","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7i","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7j","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7k","status":"UNPROJECTED_EXCEPTION"},{"rule_reference":"400.7m","status":"UNPROJECTED_EXCEPTION"}]},"projection_id":"sha256:98bfd574c774a48aaaab4753eb8eb864dc7242effa011568f2ebf59c6a9ce6f7","projection_kind":"NON_EXECUTABLE","rules":[{"concept_tags":["precedence","card_wording","concession_boundary"],"limitations":["The concession dependency at 104.3a remains unresolved.","This record supplies neither card interpretation nor a conflict resolver."],"paraphrase":"A direct conflict between a card's wording and a general rule is settled in favor of the card for that particular circumstance. Concession is a protected exception to this precedence.","rule_reference":"101.1","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":8377,"byte_start":8123,"line_number":226,"rule_reference":"101.1","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:2b1363ca9727ba1d1b4c53e8c5102ffcc25f1c28d8c39b9724a9ec2690262f14"},"topic":"Local precedence of card wording"},{"concept_tags":["precedence","permission","prohibition"],"limitations":["Ability addition and removal cannot be resolved by this priority statement.","No effect evaluation or executable permission decision is provided."],"paraphrase":"If an effect prohibits an action that a rule or another effect permits or requires, the prohibition wins that conflict. The ability modification boundary is recorded separately at 101.2a.","rule_reference":"101.2","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":8541,"byte_start":8381,"line_number":228,"rule_reference":"101.2","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:a740a6798b9adcfd6a8678c6f7b9d9c3af2024a6cf1a6cbf8f8ec9fd75ede82d"},"topic":"Prohibitions in conflicts"},{"concept_tags":["ability_modification","precedence_exception"],"limitations":["The relevant ability interaction dependency at 113.10 remains unresolved.","This exception does not define how ability modifications interact."],"paraphrase":"Giving an object an ability and taking an ability away lie outside the permission-versus-prohibition priority described by 101.2.","rule_reference":"101.2a","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":8854,"byte_start":8735,"line_number":231,"rule_reference":"101.2a","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:72078fa7cef722daeb476307f470a42d66776a79b0f04efd739edfaeb71bf41c"},"topic":"Ability modification boundary"},{"concept_tags":["instructions","impossibility","partial_completion"],"limitations":["Feasibility, instruction parsing, and card-specific consequences are not evaluated."],"paraphrase":"An instruction's unachievable portions are skipped. A consequence written on the card may still apply; absent such a consequence, the skipped portion produces no result.","rule_reference":"101.3","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":9033,"byte_start":8858,"line_number":233,"rule_reference":"101.3","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:1fbfe9f57a6a47cd5ca44cebeaeb93ed2c472cf59c14dc718913a3efbefc3f5f"},"topic":"Instructions that cannot be completed"},{"concept_tags":["player","active_player","nonactive_player"],"limitations":["Turn advancement and priority procedures are outside this projection."],"paraphrase":"A game participant is a player. The participant taking the current turn has the active role, while every remaining participant has a nonactive role.","rule_reference":"102.1","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":10898,"byte_start":10758,"line_number":250,"rule_reference":"102.1","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:8e07002f30293fad28884c95183823bed8a0042e3ac0183d32d1a4cd85a1c49a"},"topic":"Participant and turn roles"},{"concept_tags":["player","opponent","two_player_scope"],"limitations":["Multiplayer and team opponent relationships are not projected."],"paraphrase":"For a game with two participants, each participant treats the other one as their opponent.","rule_reference":"102.2","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":10973,"byte_start":10902,"line_number":252,"rule_reference":"102.2","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:852afec2046f9914b0fb75b9098bbbb7291bfeedebe2dba3e5a9b03b5383a8d1"},"topic":"Opponent in a two-person game"},{"concept_tags":["card_wording","oracle_authority","external_data_boundary"],"limitations":["This is an authority reference only; no Oracle content is acquired or interpreted.","No real Card semantics are supplied."],"paraphrase":"The wording assigned to a card is determined from its Oracle reference, which is available through Wizards' Gatherer service.","rule_reference":"108.1","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":46606,"byte_start":46439,"line_number":556,"rule_reference":"108.1","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:e79e38fcacdde0e02a204a2bd2419c55603b7f474435ddb3d74474bf6455167e"},"topic":"Authority for card wording"},{"concept_tags":["card_owner","starting_deck","outside_game","command_zone","ante_boundary"],"limitations":["The ante reference at 407 remains unresolved.","This ownership description supplies no deck, command-zone setup, or outside-game procedure."],"paraphrase":"A card's game owner is the participant whose starting deck contained it, the participant who introduced it from outside the game, or the participant who placed it in the command zone for the start. Real-world legal title ordinarily has no game-rules significance; ante is an exception governed outside this subset.","rule_reference":"108.3","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":47805,"byte_start":47315,"line_number":564,"rule_reference":"108.3","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:362c40b6810fa03b4b24ab4de7af9147ab654ae5be7f5fb197263c0061bd60df"},"topic":"Ownership assigned by game origin"},{"concept_tags":["card_controller","permanent","spell_boundary"],"limitations":["Permanent control is represented only by the selected 110.2 and 110.2a records.","Spell control at 112.2 remains unresolved."],"paraphrase":"A card has control information only when it is serving as a permanent or a spell. The corresponding permanent or spell rules determine who controls it.","rule_reference":"108.4","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":48684,"byte_start":48482,"line_number":570,"rule_reference":"108.4","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:fd5a8a61df7368772197de79e083113713a40c77c462cdc332b187ab3b188ea6"},"topic":"When a card has control information"},{"concept_tags":["card_controller","card_owner","query_fallback"],"limitations":["The fallback answers the request; it does not give the card a controller."],"paraphrase":"When a request needs the controller of a card that has none, the answer uses that card's owner instead.","rule_reference":"108.4a","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":48830,"byte_start":48688,"line_number":572,"rule_reference":"108.4a","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:72ae6dd1922dba3eb66868a3a56d745a8a3c6fc39cb52d0d91c31c712938f3d2"},"topic":"Owner fallback for a controller query"},{"concept_tags":["object","card","card_copy","token","spell","permanent","emblem","stack_ability"],"limitations":["Listing an object kind does not implement its behavior or project its defining rules."],"paraphrase":"The object category covers a card, a card copy, a token, a spell, a permanent, an emblem, and an ability while on the stack.","rule_reference":"109.1","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":49360,"byte_start":49245,"line_number":580,"rule_reference":"109.1","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:04d0fecc18123a3981363c71bee533998ea9305d180ab90e6f3b7acd17317b32"},"topic":"Kinds covered by the object vocabulary"},{"concept_tags":["characteristics","name","mana_cost","color","color_indicator","card_type","subtype","supertype","rules_text","abilities","power","toughness","loyalty","defense","hand_modifier","life_modifier","owner_is_separate","controller_is_separate","state_is_separate"],"limitations":["These are descriptive data labels, not implemented card attributes or behavior.","No characteristic calculation, state transition, targeting, or attachment semantics are projected."],"paraphrase":"An object can carry some or all of the characteristic labels enumerated here as data tags. Information outside that vocabulary belongs to other categories: who owns or controls the object, its tapped condition, its chosen targets, and an Aura's attachment relationship are examples.","rule_reference":"109.3","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":50873,"byte_start":50384,"line_number":592,"rule_reference":"109.3","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:160cd0e359e15783d9c88af51ed0135d708e32f7b0cc488fa7b28ad1aa41db01"},"topic":"Characteristics vocabulary"},{"concept_tags":["object_controller","stack","battlefield","incomplete_exception_boundary"],"limitations":["Rules 109.4a through 109.4g remain individually recorded, unprojected exceptions.","The baseline must not be treated as a complete controller lookup policy."],"paraphrase":"The baseline model assigns controllers only to objects in the stack or battlefield zones; objects elsewhere have no controller under that baseline. The listed subordinate exceptions remain outside this projection.","rule_reference":"109.4","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":51101,"byte_start":50877,"line_number":594,"rule_reference":"109.4","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:d3f3b850810090b7e92d0b327651a4983371ddd91fad2d76de842cb4d7feceef"},"topic":"Zone boundary for object control"},{"concept_tags":["permanent","battlefield","card","token","zone_membership"],"limitations":["Zone movement and token lifecycle behavior are not implemented."],"paraphrase":"A battlefield card or token qualifies as a permanent for its stay there, with no inherent time limit. Entering that zone establishes this status; leaving it ends the status.","rule_reference":"110.1","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":53025,"byte_start":52765,"line_number":614,"rule_reference":"110.1","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:bcf49ccc274770a9628b54b00372c33c8a157f82ce76a85230c2d3bc84fe1093"},"topic":"Permanent membership and duration"},{"concept_tags":["permanent_owner","permanent_controller","entry_control","token_ownership_boundary"],"limitations":["Token ownership at 111.2 remains unresolved.","Later control changes and continuous-effect interactions are outside the selected subset."],"paraphrase":"A permanent represented by a card uses that card's owner. Token ownership has a separate dependency. Every permanent has a controller, initially the participant whose control it entered under unless a relevant instruction changes that default.","rule_reference":"110.2","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":53290,"byte_start":53029,"line_number":616,"rule_reference":"110.2","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:eda2bdd4a118c93e172bc11ef399fe06d6b171be8337f81dead2578905316454"},"topic":"Permanent ownership and default control"},{"concept_tags":["entry_control","effect_instruction","default_override"],"limitations":["No placement instruction is parsed or executed.","This entry default does not resolve other control-changing rules."],"paraphrase":"When an effect directs a participant to place an object into the battlefield, that participant receives control on entry by default. A different control assignment in the effect takes priority over that default.","rule_reference":"110.2a","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":53472,"byte_start":53294,"line_number":618,"rule_reference":"110.2a","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:f564b4d71310f407c604f2a5928e18394e1a65ca125df26354a52febfa27c44e"},"topic":"Control from a battlefield placement instruction"},{"concept_tags":["zone","library","hand","battlefield","graveyard","stack","exile","command","ante","shared_zone","player_zone"],"limitations":["The inventory does not implement any zone, ante procedure, or movement operation."],"paraphrase":"Each participant has a separate graveyard, library, and hand. Battlefield, command, exile, and stack are common locations. These form the ordinary seven-location inventory; older cards can also involve ante, a shared location.","rule_reference":"400.1","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":225475,"byte_start":225177,"line_number":1938,"rule_reference":"400.1","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:58cea42b5d3605c2797cd14ffe7d4fcf1757c89b2c1bd22b18c6de60f61007c6"},"topic":"Zone inventory and sharing"},{"concept_tags":["public_zone","hidden_zone","face_down_boundary","revealed_hidden_zone"],"limitations":["Face-down permissions and reveal procedures are outside this projection.","Zone category alone cannot determine an individual card's visibility."],"paraphrase":"The public category covers command and exile, the stack and battlefield, and graveyards plus ante. This category normally lets every participant inspect a card's face, while specific face-down permissions create exceptions. Hand and library stay in the hidden category even when their entire contents have been revealed.","rule_reference":"400.2","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":225903,"byte_start":225479,"line_number":1940,"rule_reference":"400.2","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:23a4963187fe469bef1e8c42f0378cacb96d26109b538dd0da680a9d44ee736c"},"topic":"Zone visibility categories"},{"concept_tags":["zone_destination","owner","library","hand","graveyard"],"limitations":["This describes a destination constraint without executing or validating a move."],"paraphrase":"A proposed move into another participant's library, hand, or graveyard uses the matching location belonging to the object's owner instead.","rule_reference":"400.3","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":226041,"byte_start":225907,"line_number":1942,"rule_reference":"400.3","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:16c56515612de5e8c2dec35fe556c3c60296c21cabdefaf8f0dc3a2f02a4da1b"},"topic":"Owner-specific destination correction"},{"concept_tags":["zone_change","object_identity","incomplete_exception_boundary"],"limitations":["Rules 400.7a through 400.7k and 400.7m remain individually recorded, unprojected exceptions.","The baseline cannot be used as a complete zone-change identity algorithm."],"paraphrase":"Crossing between zones ordinarily starts a fresh object identity, without carrying a link to the prior identity or its history. The selected record leaves the enumerated exception cases unprojected.","rule_reference":"400.7","source_anchor":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","byte_end":228377,"byte_start":228205,"line_number":1955,"rule_reference":"400.7","span_policy":"EXACT_RULE_LINE_EXCLUDING_LINE_TERMINATOR","span_sha256":"sha256:cecd4e29bd49598e6b268456385ca119beff77fc43dac8121de5fcdeb5024e98"},"topic":"Identity boundary across zones"}],"schema_version":"gameplay-cr-foundational-projection-v1","selected_rule_count":20,"source_binding":{"artifact_hash":"sha256:8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca","artifact_review_package_id":"sha256:b5ad8b6f59c0311a33726e1733dc9bb239804bd0ab387ed789caf0d870aba36a","byte_length":977752,"correspondence_review_id":"sha256:7332e6517b1b28085bbee1fa76b8ecbc9cbe4148e261452449a308ba348d9def","effective_date":"2026-09-25","selection_id":"sha256:5f22a1aa78b5fd2ec5a0ae7d942d6065a8b065a5cc4ee79db300514a5ebe5f63","verification_result_id":"sha256:6289f9e138c248f33b950842fd079f9dc9d4be431a9ac8dc1effb4a18ec502b3"},"status":"IMPLEMENTED_PENDING_REVIEW","unsupported_dimensions":["executable_rules","real_gameplay_rules_snapshot","real_execution_profile","gameplay_rules_engine_changes","fictional_execution_profile_changes","oracle_ingestion","real_card_semantics","mana_processing","turn_timing_and_priority","casting_procedures","state_based_actions","simulation","general_or_full_comprehensive_rules_parser","full_dependency_closure","unprojected_exception_interpretation","source_prose_retention_or_redistribution"]}
